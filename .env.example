# Copy this file to .env.local for local development. Do not commit .env.local.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL local development and integration-test configuration.
# Replace the password before using this file outside local development.
POSTGRES_DB=siglum
POSTGRES_USER=siglum_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://siglum_app:change-me-local-only@127.0.0.1:5434/siglum?schema=public
DIRECT_URL=postgresql://siglum_app:change-me-local-only@127.0.0.1:5434/siglum?schema=public
TEST_DATABASE_URL=postgresql://siglum_app:change-me-local-only@127.0.0.1:5434/siglum_test?schema=public

# Authentication secrets must be independently generated high-entropy base64url values.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_IDENTIFIER_HASH_KEY=
AUTH_BOOTSTRAP_ENABLED=false
AUTH_SESSION_EXPIRES_SECONDS=43200
AUTH_SESSION_UPDATE_AGE_SECONDS=3600
AUTH_ABSOLUTE_SESSION_MAX_AGE_SECONDS=604800
AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
AUTH_FAILED_LOGIN_MAX_ATTEMPTS=10
AUTH_FAILED_LOGIN_LOCK_SECONDS=900
# Set only behind an explicitly documented, trusted proxy.
AUTH_IP_ADDRESS_HEADER=
AUTH_TRUSTED_PROXY_CIDRS=

# Dedicated HMAC key for privacy-preserving lead rate-limit and duplicate keys.
LEAD_IDENTIFIER_HASH_KEY=

# Optional S3-compatible media storage. Keep all access credentials server-only.
MEDIA_STORAGE_ENABLED=false
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=
MEDIA_KEY_PREFIX=siglum
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_READ_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_IMAGE_WIDTH=10000
MEDIA_MAX_IMAGE_HEIGHT=10000
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_REQUIRE_SHA256_CHECKSUM=true
