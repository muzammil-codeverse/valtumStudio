{
  "name": "siglum-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engineering foundation for Siglum Studio V1.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx scripts/db/run-integration-tests.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:check": "corepack pnpm db:validate && corepack pnpm db:generate && corepack pnpm auth:schema:check",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:reset:test": "tsx scripts/db/reset-test-database.ts",
    "auth:schema:generate": "auth generate --yes --config scripts/auth/schema-generation-config.ts --output prisma/auth-generated.prisma",
    "auth:schema:check": "tsx scripts/auth/check-schema.ts",
    "auth:security-check": "tsx scripts/auth/security-check.ts",
    "auth:bootstrap-owner": "tsx scripts/auth/bootstrap-owner.ts",
    "auth:reset-password": "tsx scripts/auth/reset-password.ts",
    "auth:reset-two-factor": "tsx scripts/auth/reset-two-factor.ts",
    "auth:revoke-user-sessions": "tsx scripts/auth/revoke-user-sessions.ts",
    "test:auth": "vitest run src/modules/auth src/config/env/auth.test.ts",
    "test:authorization": "vitest run src/modules/auth/policies",
    "test:security": "vitest run src/server/security src/modules/auth",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm db:check && corepack pnpm auth:security-check && corepack pnpm test",
    "ci:verify": "corepack pnpm check && corepack pnpm test:coverage && corepack pnpm test:integration && corepack pnpm build && corepack pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@better-auth/prisma-adapter": "1.6.23",
    "@lexical/history": "^0.47.0",
    "@lexical/link": "^0.47.0",
    "@lexical/list": "^0.47.0",
    "@lexical/react": "^0.47.0",
    "@lexical/rich-text": "^0.47.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.23",
    "lexical": "^0.47.0",
    "next": "16.2.10",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.23",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
